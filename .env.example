# SocialFlow — environment variables (PRD §20). Copy to .env.local and fill real values.

# --- Application ---
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api
ENCRYPTION_KEY=            # 32-byte base64, kept OUTSIDE the database, versioned for rotation
WORKER_SECRET=             # shared secret between web and worker/cron
CRON_SECRET=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY= # server only, never sent to browser
DATABASE_URL=              # direct Postgres connection for migrations

# --- Queue ---
REDIS_URL=

# --- Storage (Cloudflare R2 / S3-compatible) ---
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_MEDIA_DOMAIN=   # verified domain that only serves signed URLs

# --- Meta (Facebook Pages + Instagram) ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_WEBHOOK_VERIFY_TOKEN=

# --- LinkedIn ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_PROFESSIONAL=
RAZORPAY_PLAN_AGENCY=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_SENDER_DOMAIN=

# --- Monitoring ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
